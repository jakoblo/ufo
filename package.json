{
  "name": "ufo",
  "productName": "ufo",
  "main": ".webpack/main",
  "version": "0.0.0",
  "description": "Custom Filemanager to make notes where you need them.",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:test": "electron-forge package",
    "test:e2e": "playwright test"
  },
  "author": "Sebastian Wolf, Jakob Lobensteiner",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^1.6.1",
    "classnames": "^2.2.5",
    "dom-scroll-into-view": "^1.2.1",
    "electron-json-storage": "^3.0.1",
    "electron-log": "^4.4.8",
    "electron-window-state": "^4.1.0",
    "filesize": "^3.3.0",
    "get-folder-size": "^1.0.0",
    "graceful-ncp": "^3.0.0",
    "immutable": "^3.8.1",
    "is-url": "^1.2.2",
    "lodash": "^4.15.0",
    "mammoth": "^1.2.1",
    "mz": "^2.4.0",
    "normalize-url": "^1.9.1",
    "prismjs": "^1.6.0",
    "progress-stream": "^2.0.0",
    "rc-tooltip": "^3.4.3",
    "react": "^16.0.0-alpha.13",
    "react-dom": "^16.0.0-alpha.13",
    "react-measure": "^1.4.6",
    "react-motion": "^0.5.0",
    "react-portal": "^3.0.0",
    "react-redux": "^5.0.2",
    "react-resizable": "^1.6.0",
    "redux": "^3.6.0",
    "redux-logger": "^3.0.1",
    "redux-thunk": "^2.2.0",
    "reselect": "^3.0.0",
    "rimraf": "^2.5.4",
    "scroll-into-view": "^1.8.0",
    "slate": "^0.19.20",
    "tldjs": "^1.7.0",
    "trash": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.23.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-flow": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@electron-forge/cli": "^6.4.2",
    "@electron-forge/maker-squirrel": "^6.4.2",
    "@electron-forge/maker-zip": "^6.4.2",
    "@electron-forge/plugin-webpack": "^6.4.2",
    "@playwright/test": "^1.61.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "electron": "^13.6.9",
    "eslint": "^3.3.0",
    "eslint-plugin-react": "^6.1.0",
    "flow-bin": "^0.45.0",
    "gulp": "^4.0.0",
    "gulp-google-webfonts": "0.0.14",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "node-gyp": "^10.0.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-node-externals": "^3.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./src/icon/icon",
        "overwrite": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "ufo"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/html/window.html",
                  "js": "./src/js/renderer.js",
                  "name": "main_window"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
